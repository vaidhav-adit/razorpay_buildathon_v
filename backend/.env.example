# ─────────────────────────────────────────────────────────────────────────────
# Environment variable template for the RazorpayX Exception Resolution Agent
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL connection string ──────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/razorpay_agent

# ── Application settings ──────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# ── Razorpay credentials (Test Mode) ─────────────────────────────────────────
# Get these from your Razorpay Dashboard > Settings > API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Zoho Books (Sandbox) ──────────────────────────────────────────────────────
# Get these after creating a Zoho OAuth app in the API Console
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:8000/auth/zoho/callback
ZOHO_ORGANIZATION_ID=your_zoho_org_id

# ── LLM (added in Phase 10) ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Validation thresholds (used by the policy engine in Phase 4) ──────────────
# Minimum name match score from bank validation to auto-approve a fund account
MIN_NAME_MATCH_SCORE=85
