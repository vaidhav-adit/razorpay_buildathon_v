# ── Virtual environments ─────────────────────────────────────────────────────
razor/
venv/
.venv/
env/

# ── Python bytecache ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# ── Environment variables (never commit secrets) ──────────────────────────────
.env
.env.*
!.env.example

# ── Distribution / packaging ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── IDE and editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Alembic (keep versions tracked, ignore pycache inside) ───────────────────
backend/alembic/versions/__pycache__/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Node.js / Next.js ──────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
*.tsbuildinfo
next-env.d.ts

# ── Internal Planning and Scratch Files ──────────────────────────────────────
antigrav_plan.md
implementation_plan.md
Absolutely.md
must_follow.md
razorpay_api.md


